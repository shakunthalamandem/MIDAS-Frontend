import React, { useEffect, useState } from 'react';
import axios from 'axios';
import { FaBullseye, FaHandshake, FaTruckMoving, FaChartLine, FaClipboardList } from 'react-icons/fa';

const IPODealsS1DealData = () => {
  const apiUrl = process.env.REACT_APP_API_URL;
  const token = localStorage.getItem("access_token");
  const [dealData, setDealData] = useState(null);

  useEffect(() => {
    const fetchDealData = async () => {
      try {
        const response = await axios.get(`${apiUrl}/api/s1-deals_fair/`, {
          headers: {
            Authorization: `Bearer ${token}`
          }
        });
        if (response.data && response.data.length > 0) {
          setDealData(response.data[0]);
        }
      } catch (error) {
        console.error("Error fetching deal data:", error);
      }
    };

    fetchDealData();
  }, [apiUrl, token]);

  if (!dealData) return <p>Loading...</p>;

  return (
    <>
      <section style={{ maxWidth: '600px', margin: '20px auto', background: '#fff', boxShadow: '0 2px 8px rgba(0,0,0,0.1)', borderRadius: '10px', padding: '20px' }}>
        
        <article style={{ display: 'flex', gap: '15px', marginBottom: '20px' }}>
          <FaBullseye size={24} color="#2563EB" />
          <section>
            <h3 style={{ margin: 0 }}>Fair Value Estimate</h3>
            <p style={{ margin: 0 }}>{dealData.fair_value_estimate} per share</p>
          </section>
        </article>

        <article style={{ display: 'flex', gap: '15px', marginBottom: '20px' }}>
          <FaHandshake size={24} color="#2563EB" />
          <section>
            <h3 style={{ margin: 0 }}>Indication of Interest (IOI)</h3>
            <p style={{ margin: 0 }}>Initial interest: {dealData.indication_of_interest}</p>
          </section>
        </article>

        <article style={{ display: 'flex', gap: '15px', marginBottom: '20px' }}>
          <FaTruckMoving size={24} color="#2563EB" />
          <section>
            <h3 style={{ margin: 0 }}>After Market (AM) Threshold</h3>
            <p style={{ margin: 0 }}>Buy more if price drops by {dealData.after_market_threshold}</p>
          </section>
        </article>

        <article style={{ display: 'flex', gap: '15px', marginBottom: '20px' }}>
          <FaChartLine size={24} color="#2563EB" />
          <section>
            <h3 style={{ margin: 0 }}>Monashee Score</h3>
            <p style={{ margin: 0 }}>{dealData.monashee_score} / 10 (based on similar IPOs)</p>
          </section>
        </article>

        <article style={{ display: 'flex', gap: '15px' }}>
          <FaClipboardList size={24} color="#2563EB" />
          <section>
            <h3 style={{ margin: 0 }}>Differentiated Summary</h3>
            <p style={{ margin: 0 }}>{dealData.differentiated_summary}</p>
          </section>
        </article>

      </section>
    </>
  );
};

export default IPODealsS1DealData;
