{
    "DealSpecific": {
      "Primary": {
        "type": "dropdown",
        "description": "Select a range or specific value for the primary category.",
        "options": ["ALL", "=0", "=100", "0-20", "20-40", "40-60", "60-80", "80-100"]
      },
      "LeadBank": {
        "type": "dropdown",
        "description": "Select a lead bank from the available options fetched from the API.",
        "api": "http://192.168.1.59:9000/api/mdd_distinct_values/",
        "key": "lead_bank"
      },
      "Sponsor": {
        "type": "dropdown",
        "description": "Choose whether the sponsor is involved in the deal.",
        "options": ["Yes", "No"]
      },
      "FollowOnDiscount": {
        "type": "input",
        "description": "Specify the discount for follow-on as a range using input fields.",
        "fields": [
          { "type": "number", "operator": ">", "label": "User Input >", "placeholder": "Enter minimum discount" },
          { "type": "number", "operator": "<", "label": "User Input <", "placeholder": "Enter maximum discount" }
        ]
      },
      "TPlus1DayToIndexPercent": {
        "type": "input",
        "description": "Specify the percentage change from T+1 day to the index.",
        "fields": [
          { "type": "number", "operator": ">", "label": "User Input >", "placeholder": "Enter minimum percentage" },
          { "type": "number", "operator": "<", "label": "User Input <", "placeholder": "Enter maximum percentage" }
        ]
      }
    },
    "MonahseeSpecific": {
      "AllocationPercentOfDealSize": {
        "type": "input",
        "description": "Enter the allocation percentage of the deal size as a range.",
        "fields": [
          { "type": "number", "operator": ">", "label": "User Input >", "placeholder": "Enter minimum percentage" },
          { "type": "number", "operator": "<", "label": "User Input <", "placeholder": "Enter maximum percentage" }
        ]
      },
      "AllocationPercentOfIOI": {
        "type": "input",
        "description": "Enter the allocation percentage of IOI as a range.",
        "fields": [
          { "type": "number", "operator": ">", "label": "User Input >", "placeholder": "Enter minimum percentage" },
          { "type": "number", "operator": "<", "label": "User Input <", "placeholder": "Enter maximum percentage" }
        ]
      },
      "HoldPeriod": {
        "type": "input",
        "description": "Specify the hold period as a range using input fields.",
        "fields": [
          { "type": "number", "operator": ">", "label": "User Input >", "placeholder": "Enter minimum period" },
          { "type": "number", "operator": "<", "label": "User Input <", "placeholder": "Enter maximum period" }
        ]
      },
      "DealCaption": {
        "type": "dropdown",
        "description": "Select a deal caption from the options fetched from the API.",
        "api": "http://192.168.1.59:9000/api/mdd_distinct_values/",
        "key": "DealCaption"
      }
    }
